# Copy this file to .env for local development. Never commit the real .env.

# Neon Postgres pooled connection string. Leave this unset (or commented out)
# to fall back to a local SQLite file at ./rental.db.
# DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Signs the session cookie and the CSRF tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# The Android app's package name and signing-key SHA-256 fingerprint(s), from
# `bubblewrap init`. Only needed in production; see "The Android app" in README.
# ANDROID_PACKAGE_NAME=com.ordrid.vehiclerental
# ANDROID_CERT_FINGERPRINTS=AB:CD:...
